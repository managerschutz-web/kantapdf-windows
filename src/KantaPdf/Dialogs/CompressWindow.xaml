<Window x:Class="KantaPdf.Dialogs.CompressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verkleinern" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/kanta.ico"
        Background="{DynamicResource Bar}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="24,22,24,20">
    <TextBlock Text="PDF verkleinern" Style="{StaticResource DialogTitle}"/>
    <TextBlock x:Name="Sub" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,14"/>
    <RadioButton x:Name="RLight" GroupName="l">
      <StackPanel><TextBlock Text="Leicht" FontWeight="SemiBold"/>
        <TextBlock Text="Kaum sichtbarer Unterschied – gut zum Archivieren" Style="{StaticResource Hint}"/></StackPanel>
    </RadioButton>
    <RadioButton x:Name="RMedium" GroupName="l" IsChecked="True">
      <StackPanel><TextBlock Text="Mittel" FontWeight="SemiBold"/>
        <TextBlock Text="Ideal für E-Mail – Scans bleiben gut lesbar" Style="{StaticResource Hint}"/></StackPanel>
    </RadioButton>
    <RadioButton x:Name="RStrong" GroupName="l">
      <StackPanel><TextBlock Text="Stark" FontWeight="SemiBold"/>
        <TextBlock Text="So klein wie möglich – Fotos werden sichtbar weicher" Style="{StaticResource Hint}"/></StackPanel>
    </RadioButton>
    <TextBlock Text="Text bleibt immer durchsuchbar und markierbar – verkleinert werden nur Bilder und Scans."
               Style="{StaticResource Hint}" Margin="0,10,0,0"/>
    <TextBlock x:Name="Status" Style="{StaticResource Hint}" FontSize="13" Margin="0,14,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="BtnCancel" Content="Abbrechen" Click="Cancel_Click"/>
      <Button x:Name="BtnRun" Style="{StaticResource Primary}" Content="Verkleinern" Click="Run_Click" Margin="8,0,0,0" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
