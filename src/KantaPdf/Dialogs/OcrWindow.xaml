<Window x:Class="KantaPdf.Dialogs.OcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/kanta.ico"
        Background="{DynamicResource Bar}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="24,22,24,20">
    <TextBlock Text="Durchsuchbar machen (OCR)" Style="{StaticResource DialogTitle}"/>
    <TextBlock Text="Gescannte Seiten bekommen eine unsichtbare Textschicht. Danach kann man suchen, markieren und kopieren. Das Aussehen bleibt gleich."
               Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,14"/>
    <TextBlock x:Name="Lang" Margin="0,0,0,6"/>
    <CheckBox x:Name="SkipText" IsChecked="True" Content="Seiten überspringen, die schon Text enthalten"/>
    <TextBlock Text="Läuft komplett offline mit der Texterkennung von Windows." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
    <TextBlock x:Name="Status" Style="{StaticResource Hint}" FontSize="13" Margin="0,14,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="BtnCancel" Content="Abbrechen" Click="Cancel_Click"/>
      <Button x:Name="BtnRun" Style="{StaticResource Primary}" Content="Erkennen" Click="Run_Click" Margin="8,0,0,0" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
