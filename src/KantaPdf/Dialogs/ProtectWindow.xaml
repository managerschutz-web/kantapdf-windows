<Window x:Class="KantaPdf.Dialogs.ProtectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kennwort" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/kanta.ico"
        Background="{DynamicResource Bar}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="24,22,24,20">
    <TextBlock Text="Kennwortschutz" Style="{StaticResource DialogTitle}"/>
    <TextBlock x:Name="Sub" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,14"/>
    <RadioButton x:Name="RSet" GroupName="p" IsChecked="True" Content="Kennwort setzen" Checked="Mode_Changed"/>
    <RadioButton x:Name="RRemove" GroupName="p" Content="Kennwortschutz entfernen" Checked="Mode_Changed"/>
    <StackPanel x:Name="SetPanel" Margin="0,10,0,0">
      <TextBlock Text="Kennwort zum Öffnen"/>
      <PasswordBox x:Name="Pw1" Padding="6,5" Margin="0,4,0,10" Background="{DynamicResource Field}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}"/>
      <TextBlock Text="Kennwort wiederholen"/>
      <PasswordBox x:Name="Pw2" Padding="6,5" Margin="0,4,0,12" Background="{DynamicResource Field}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}"/>
      <TextBlock Text="Was darf man nach dem Öffnen?" FontWeight="SemiBold" Margin="0,4,0,0"/>
      <CheckBox x:Name="AllowPrint" IsChecked="True" Content="Drucken"/>
      <CheckBox x:Name="AllowCopy" IsChecked="False" Content="Text und Bilder kopieren"/>
      <CheckBox x:Name="AllowEdit" IsChecked="False" Content="Ändern, kommentieren, Seiten umstellen"/>
      <TextBlock Text="Hinweis: Ohne Kennwort lässt sich die Datei nicht mehr öffnen – gut merken!"
                 Style="{StaticResource Hint}" Margin="0,8,0,0"/>
    </StackPanel>
    <TextBlock x:Name="Status" Style="{StaticResource Hint}" FontSize="13" Margin="0,14,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="BtnCancel" Content="Abbrechen" Click="Cancel_Click"/>
      <Button x:Name="BtnRun" Style="{StaticResource Primary}" Content="Speichern" Click="Run_Click" Margin="8,0,0,0" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
