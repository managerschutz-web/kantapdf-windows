<Window x:Class="KantaPdf.Dialogs.SignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unterschreiben" Width="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/kanta.ico"
        Background="{DynamicResource Bar}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="24,22,24,20">
    <TextBlock Text="Unterschreiben" Style="{StaticResource DialogTitle}"/>
    <TextBlock Text="Gespeicherte Unterschrift wählen oder neu zeichnen. Danach auf die Stelle im Dokument klicken – verschieben und Größe ändern geht jederzeit."
               Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,14"/>

    <StackPanel x:Name="SavedBlock">
      <TextBlock Text="Gespeichert" FontWeight="SemiBold"/>
      <WrapPanel x:Name="SavedPanel" Margin="0,8,0,16"/>
    </StackPanel>

    <TextBlock Text="Neue Unterschrift" FontWeight="SemiBold"/>
    <Border Margin="0,8,0,0" CornerRadius="12" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1" Height="200">
      <Grid>
        <Rectangle Height="1.2" VerticalAlignment="Bottom" Margin="34,0,34,52" Fill="#C9CEC2"/>
        <TextBlock Text="✕" Foreground="#A0A69A" FontSize="16" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="18,0,0,54"/>
        <TextBlock x:Name="InkHint" Text="Hier mit Maus, Stift oder Finger unterschreiben" Foreground="#A9AFA3"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <InkCanvas x:Name="Ink" Background="Transparent" Cursor="Pen"/>
      </Grid>
    </Border>
    <DockPanel Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <Button Content="Leeren" Click="Clear_Click"/>
        <Button Content="Bild laden …" Click="Load_Click" ToolTip="Eingescannte Unterschrift (weißer Hintergrund wird entfernt)"/>
      </StackPanel>
      <CheckBox x:Name="Remember" IsChecked="True" Content="Für später speichern" HorizontalAlignment="Right"/>
    </DockPanel>

    <TextBlock x:Name="Status" Style="{StaticResource Hint}" FontSize="13" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Abbrechen" Click="Cancel_Click"/>
      <Button Style="{StaticResource Primary}" Content="Unterschrift verwenden" Click="Use_Click" Margin="8,0,0,0"/>
    </StackPanel>
  </StackPanel>
</Window>
