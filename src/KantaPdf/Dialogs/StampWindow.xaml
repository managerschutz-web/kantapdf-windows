<Window x:Class="KantaPdf.Dialogs.StampWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stempel" Width="700" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/kanta.ico"
        Background="{DynamicResource Bar}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="24,22,24,20">
    <TextBlock Text="Stempel" Style="{StaticResource DialogTitle}"/>
    <TextBlock Text="Stempel wählen, dann auf die Stelle im Dokument klicken. Das Datum ist immer das heutige. Eigene Stempel: Rechtsklick → Löschen."
               Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,14"/>

    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
      <WrapPanel x:Name="StampPanel"/>
    </ScrollViewer>

    <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,16"/>

    <TextBlock Text="Eigenen Stempel gestalten" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="260"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Text" Style="{StaticResource Hint}"/>
        <TextBox x:Name="Line1" Text="Bearbeitet" Margin="0,3,0,10" TextChanged="Def_Changed"/>
        <TextBlock Text="Zusatzzeile (optional, z. B. Name oder Abteilung)" Style="{StaticResource Hint}"/>
        <TextBox x:Name="Line2" Margin="0,3,0,10" TextChanged="Def_Changed"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <TextBlock Text="Farbe" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <StackPanel x:Name="ColorPanel" Orientation="Horizontal"/>
        </StackPanel>
        <CheckBox x:Name="WithDate" IsChecked="True" Content="Datum anfügen" Checked="Def_Changed" Unchecked="Def_Changed"/>
      </StackPanel>
      <Border Grid.Column="2" CornerRadius="12" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1" MinHeight="120" Padding="14">
        <Image x:Name="Preview" Stretch="Uniform" MaxHeight="90" VerticalAlignment="Center"/>
      </Border>
    </Grid>
    <DockPanel Margin="0,12,0,0">
      <Button DockPanel.Dock="Left" Content="Bild als Stempel laden …" Click="LoadImage_Click" ToolTip="z. B. Firmenlogo oder eingescannter Stempel"/>
      <Button Style="{StaticResource Primary}" Content="Stempel speichern" Click="SaveOwn_Click" HorizontalAlignment="Right"/>
    </DockPanel>

    <TextBlock x:Name="Status" Style="{StaticResource Hint}" FontSize="13" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Schließen" Click="Cancel_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
