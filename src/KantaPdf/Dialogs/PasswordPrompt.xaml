<Window x:Class="KantaPdf.Dialogs.PasswordPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kennwort" Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/kanta.ico"
        Background="{DynamicResource Bar}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="24,22,24,20">
    <TextBlock Text="Kennwortgeschützte PDF" Style="{StaticResource DialogTitle}"/>
    <TextBlock x:Name="Sub" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,14"/>
    <PasswordBox x:Name="Pw" Padding="6,5" Background="{DynamicResource Field}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}"/>
    <TextBlock x:Name="Status" Style="{StaticResource Hint}" FontSize="13" Margin="0,14,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="BtnCancel" Content="Abbrechen" Click="Cancel_Click"/>
      <Button x:Name="BtnRun" Style="{StaticResource Primary}" Content="Öffnen" Click="Run_Click" Margin="8,0,0,0" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
