<Window x:Class="KantaPdf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KANTApdf" Width="1320" Height="900" MinWidth="980" MinHeight="560"
        Icon="Assets/kanta.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing"
        PreviewMouseWheel="Window_PreviewMouseWheel" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═════════ Kopfleiste ═════════ -->
    <Border x:Name="Header" Background="{DynamicResource Bar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- links: Marke, Leiste, Öffnen, Speichern -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/kanta.png" Width="26" Height="26" Margin="4,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock VerticalAlignment="Center" FontSize="15" Margin="0,0,12,0">
            <Run Text="KANTA" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><Run Text="pdf" Foreground="{DynamicResource Muted}"/>
          </TextBlock>
          <Button x:Name="BtnSidebar" Click="SidebarToggle_Click" ToolTip="Seitenleiste ein-/ausblenden" Padding="8,6">
            <TextBlock Style="{StaticResource Ico}" Text="&#xE700;"/>
          </Button>
          <Button Click="Open_Click" ToolTip="PDF öffnen (Strg+O)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE8E5;" Margin="0,0,7,0"/>
              <TextBlock Text="Öffnen"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnSave" Click="Save_Click" ToolTip="Speichern (Strg+S) · Speichern unter (Strg+Umschalt+S)">
            <StackPanel Orientation="Horizontal">
              <Grid Margin="0,0,7,0">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE74E;"/>
                <Ellipse x:Name="DirtyDot" Width="7" Height="7" Fill="{DynamicResource Accent}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" Visibility="Collapsed"/>
              </Grid>
              <TextBlock Text="Speichern"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnSaveAs" Click="SaveAs_Click" ToolTip="Speichern unter … (Strg+Umschalt+S)" Padding="8,6">
            <TextBlock Style="{StaticResource Ico}" Text="&#xE792;"/>
          </Button>
          <Button x:Name="BtnPrint" Click="Print_Click" ToolTip="Drucken (Strg+P)" Padding="8,6">
            <TextBlock Style="{StaticResource Ico}" Text="&#xE749;"/>
          </Button>
          <Button x:Name="BtnSearch" Click="Search_Click" ToolTip="Suchen (Strg+F)" Padding="8,6">
            <TextBlock Style="{StaticResource Ico}" Text="&#xE721;"/>
          </Button>
          <Border x:Name="FileChip" Background="{DynamicResource Pill}" CornerRadius="9" Padding="10,3,4,3" Margin="10,0,0,0"
                  VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="FileName" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="230" FontSize="12.5"/>
              <Button Click="CloseDoc_Click" Padding="6,3" Margin="4,0,0,0" ToolTip="Dokument schließen (Strg+W)">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE711;" FontSize="10"/>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Mitte: Werkzeug-Schalter -->
        <Border x:Name="ToolPill" Grid.Column="1" Background="{DynamicResource Pill}" CornerRadius="10" Padding="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ToolText" Style="{StaticResource Seg}" GroupName="tool" IsChecked="True" Checked="Tool_Checked"
                         ToolTip="Auswählen: Text markieren und kopieren (Strg+C), Formulare ausfüllen">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE8B3;" FontSize="14" Margin="0,0,6,0"/>
                <TextBlock Text="Auswählen"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ToolWrite" Style="{StaticResource Seg}" GroupName="tool" Checked="Tool_Checked"
                         ToolTip="Text einfügen – wird fest in die Seite geschrieben">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE8D2;" FontSize="14" Margin="0,0,6,0"/>
                <TextBlock Text="Schreiben"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ToolMarker" Style="{StaticResource Seg}" GroupName="tool" Checked="Tool_Checked"
                         ToolTip="Text mit Textmarker hervorheben">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE7E6;" FontSize="14" Margin="0,0,6,0"/>
                <TextBlock Text="Marker"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ToolNote" Style="{StaticResource Seg}" GroupName="tool" Checked="Tool_Checked"
                         ToolTip="Notiz an eine Stelle heften">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE90A;" FontSize="14" Margin="0,0,6,0"/>
                <TextBlock Text="Notiz"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ToolRedact" Style="{StaticResource Seg}" GroupName="tool" Checked="Tool_Checked"
                         ToolTip="Bereiche endgültig schwärzen">
              <StackPanel Orientation="Horizontal">
                <Border Width="13" Height="8" CornerRadius="1.5" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="Schwärzen"/>
              </StackPanel>
            </RadioButton>
            <Border Width="1" Background="{DynamicResource Line}" Margin="6,5"/>
            <Button Click="Sign_Click" Padding="11,5" Margin="0" ToolTip="Unterschrift einfügen">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Ico}" Text="&#xEE56;" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource Muted}"/>
                <TextBlock Text="Unterschreiben" Foreground="{DynamicResource Muted}"/>
              </StackPanel>
            </Button>
            <Button Click="Stamp_Click" Padding="11,5" Margin="0" ToolTip="Stempel einfügen">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE8EC;" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource Muted}"/>
                <TextBlock Text="Stempel" Foreground="{DynamicResource Muted}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- rechts: Werkzeuge, Zoom, Ansicht -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <ToggleButton x:Name="ToolsToggle" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="2,0">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="b" CornerRadius="8" Padding="11,6" Background="Transparent">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE90F;" Margin="0,0,7,0" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="Werkzeuge" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE70D;" FontSize="10" Margin="7,1,0,0" Foreground="{DynamicResource Accent}"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                  </Trigger>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <Popup IsOpen="{Binding IsChecked, ElementName=ToolsToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ToolsToggle}"
                 Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-150" VerticalOffset="6">
            <Border Background="{DynamicResource Bar}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    Padding="6" Margin="12" Width="300">
              <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18"/>
              </Border.Effect>
              <StackPanel>
                <Button Style="{StaticResource MenuBtn}" Click="Merge_Click">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE8F1;" Foreground="{DynamicResource Accent}" FontSize="17"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Zusammenfügen" FontWeight="SemiBold"/>
                      <TextBlock Text="Mehrere PDFs zu einer verbinden" Style="{StaticResource Hint}"/></StackPanel></Grid>
                </Button>
                <Button x:Name="MenuSplit" Style="{StaticResource MenuBtn}" Click="Split_Click">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE8C6;" Foreground="{DynamicResource Accent}" FontSize="17"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Teilen" FontWeight="SemiBold"/>
                      <TextBlock Text="In mehrere Dateien aufteilen" Style="{StaticResource Hint}"/></StackPanel></Grid>
                </Button>
                <Button x:Name="MenuRotate" Style="{StaticResource MenuBtn}" Click="MenuRotate_Click">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE7AD;" Foreground="{DynamicResource Accent}" FontSize="17"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Seite drehen" FontWeight="SemiBold"/>
                      <TextBlock Text="Aktuelle/markierte Seiten 90° nach rechts (Strg+R)" Style="{StaticResource Hint}"/></StackPanel></Grid>
                </Button>
                <Button x:Name="MenuCrop" Style="{StaticResource MenuBtn}" Click="MenuCrop_Click">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE7A8;" Foreground="{DynamicResource Accent}" FontSize="17"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Seite zuschneiden" FontWeight="SemiBold"/>
                      <TextBlock Text="Ränder wegschneiden – eine oder alle Seiten" Style="{StaticResource Hint}"/></StackPanel></Grid>
                </Button>
                <Button x:Name="MenuOcr" Style="{StaticResource MenuBtn}" Click="Ocr_Click">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE8FE;" Foreground="{DynamicResource Accent}" FontSize="17"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="OCR – durchsuchbar machen" FontWeight="SemiBold"/>
                      <TextBlock Text="Scans werden markier- und kopierbar" Style="{StaticResource Hint}"/></StackPanel></Grid>
                </Button>
                <Button x:Name="MenuCompress" Style="{StaticResource MenuBtn}" Click="Compress_Click">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE73F;" Foreground="{DynamicResource Accent}" FontSize="17"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Verkleinern" FontWeight="SemiBold"/>
                      <TextBlock Text="Dateigröße reduzieren, Text bleibt" Style="{StaticResource Hint}"/></StackPanel></Grid>
                </Button>
                <Button x:Name="MenuProtect" Style="{StaticResource MenuBtn}" Click="Protect_Click">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE72E;" Foreground="{DynamicResource Accent}" FontSize="17"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Kennwort" FontWeight="SemiBold"/>
                      <TextBlock Text="Schutz setzen oder entfernen" Style="{StaticResource Hint}"/></StackPanel></Grid>
                </Button>
                <Border Height="1" Background="{DynamicResource Line}" Margin="8,4"/>
                <Button Style="{StaticResource MenuBtn}" Click="Setup_Click">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Ico}" Text="&#xE7F4;" Foreground="{DynamicResource Muted}" FontSize="17"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="Einrichten" FontWeight="SemiBold"/>
                      <TextBlock Text="Desktop-Verknüpfung, Startmenü, „Öffnen mit“" Style="{StaticResource Hint}"/></StackPanel></Grid>
                </Button>
              </StackPanel>
            </Border>
          </Popup>

          <Border Background="{DynamicResource Pill}" CornerRadius="10" Padding="2" Margin="8,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Click="ZoomOut_Click" Padding="9,5" ToolTip="Verkleinern (Strg+Minus)">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE71F;" FontSize="13"/>
              </Button>
              <Button x:Name="ZoomText" Content="100 %" Click="Fit_Click" MinWidth="58" Padding="6,5" ToolTip="Auf Breite einpassen (Strg+0)"/>
              <Button Click="ZoomIn_Click" Padding="9,5" ToolTip="Vergrößern (Strg+Plus)">
                <TextBlock Style="{StaticResource Ico}" Text="&#xE8A3;" FontSize="13"/>
              </Button>
            </StackPanel>
          </Border>
          <Button Click="Focus_Click" Margin="6,0,0,0" Padding="8,6" ToolTip="Fokusmodus – nur das Dokument (F11)">
            <TextBlock Style="{StaticResource Ico}" Text="&#xE740;"/>
          </Button>
          <Button x:Name="BtnMode" Click="Mode_Click" Margin="2,0,0,0" ToolTip="Ansicht: Papier · Sepia · Nacht">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE706;" Margin="0,0,6,0"/>
              <TextBlock x:Name="ModeText" Text="Papier"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═════════ Hinweisleiste je Werkzeug ═════════ -->
    <Border x:Name="ModeBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource AccentSoft}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,7">
      <DockPanel>
        <StackPanel x:Name="MarkerColors" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
          <TextBlock Text="Farbe" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/>
        </StackPanel>
        <StackPanel x:Name="CropActions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
          <CheckBox x:Name="CropAll" Content="Auf alle Seiten anwenden" Margin="0,0,14,0"/>
          <Button Content="Original" Click="CropReset_Click" ToolTip="Zuschnitt entfernen"/>
          <Button Content="Abbrechen" Click="CropCancel_Click"/>
          <Button Style="{StaticResource Primary}" Content="Zuschneiden" Click="CropApply_Click" Margin="6,0,0,0"/>
        </StackPanel>
        <StackPanel x:Name="RedactActions" DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Alle Balken entfernen" Click="RedactClear_Click"/>
          <Button x:Name="BtnRedactApply" Style="{StaticResource Primary}" Content="Schwärzen &amp; speichern unter …" Click="RedactApply_Click" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
          <Run x:Name="ModeTitle" FontWeight="SemiBold"/>
          <Run x:Name="ModeHint"/>
          <Run x:Name="ModeCount" Foreground="{DynamicResource Muted}"/>
        </TextBlock>
      </DockPanel>
    </Border>

    <!-- ═════════ Inhalt ═════════ -->
    <Grid Grid.Row="2" x:Name="ContentGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SideCol" Width="210" MinWidth="0" MaxWidth="560"/>
        <ColumnDefinition x:Name="SplitCol" Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Seitenleiste -->
      <Border x:Name="Sidebar" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="10,10,10,6">
            <DockPanel>
              <TextBlock x:Name="PageCountText" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
              <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="2" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="TabPages" Style="{StaticResource Seg}" GroupName="side" IsChecked="True" Content="Seiten" Checked="SideTab_Checked"/>
                  <RadioButton x:Name="TabNotes" Style="{StaticResource Seg}" GroupName="side" Checked="SideTab_Checked">
                    <TextBlock><Run Text="Notizen"/><Run x:Name="NotesCount" Foreground="{DynamicResource Muted}"/></TextBlock>
                  </RadioButton>
                </StackPanel>
              </Border>
            </DockPanel>
          </Border>

          <!-- Anhängen-Feld -->
          <Grid x:Name="AppendZone" DockPanel.Dock="Bottom" Margin="12,6,12,12" Cursor="Hand" Background="Transparent"
                MouseLeftButtonUp="AppendZone_Click" AllowDrop="True" Drop="AppendZone_Drop" DragOver="Window_DragOver"
                ToolTip="Weitere PDFs hinten anhängen – oder Dateien direkt auf eine Seitenvorschau ziehen">
            <Rectangle x:Name="AppendRect" RadiusX="10" RadiusY="10" Stroke="{DynamicResource Muted}" StrokeThickness="1.3"
                       StrokeDashArray="4 3" Opacity="0.6"/>
            <StackPanel Margin="10,12" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE710;" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" FontSize="16"/>
              <TextBlock Text="PDF anhängen" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,4,0,0"/>
              <TextBlock Text="klicken oder hierher ziehen" HorizontalAlignment="Center" Style="{StaticResource Hint}" FontSize="11"/>
            </StackPanel>
          </Grid>

          <Grid>
            <!-- Seiten-Vorschau -->
            <ListBox x:Name="ThumbList" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Padding="0,2,0,6"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AllowDrop="True" Drop="Thumb_Drop" DragOver="Window_DragOver"
                     SelectionChanged="Thumb_SelectionChanged" PreviewKeyDown="Thumb_KeyDown"
                     PreviewMouseLeftButtonUp="Thumb_Clicked"
                     PreviewMouseLeftButtonDown="Thumb_PreviewDown" PreviewMouseMove="Thumb_PreviewMove"
                     PreviewMouseRightButtonUp="Thumb_RightClick">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                  <Setter Property="HorizontalContentAlignment" Value="Center"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Background="Transparent" Margin="0,7,0,3" HorizontalAlignment="Center">
                          <Grid>
                            <Border x:Name="Ring" Margin="-5" CornerRadius="7" BorderThickness="2.5"
                                    BorderBrush="{DynamicResource Accent}" Visibility="Hidden"/>
                            <Border x:Name="Frame" Width="{Binding ThumbW}" Height="{Binding ThumbH}" CornerRadius="3"
                                    Background="{DynamicResource PagePlaceholder}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                              <Image Source="{Binding Thumb}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel x:Name="Del" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,6,6,0" Visibility="Hidden">
                              <Button Style="{StaticResource IconChipSoft}" Content="&#xE7AD;" Click="ThumbRotate_Click" Margin="0,0,5,0"
                                      ToolTip="Seite nach rechts drehen"/>
                              <Button Style="{StaticResource IconChip}" Content="&#xE74D;" Click="ThumbDelete_Click"
                                      ToolTip="Seite löschen (Entf)"/>
                            </StackPanel>
                          </Grid>
                          <TextBlock x:Name="Num" Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,7,0,0"
                                     FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Del" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Muted}"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Num" Property="FontWeight" Value="SemiBold"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Notizen-Liste -->
            <ListBox x:Name="NotesList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="8,2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="NotesList_Clicked">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Margin="2,4" Padding="12,10" CornerRadius="10" Background="{DynamicResource Bar}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1" Cursor="Hand">
                          <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{DynamicResource NoteBg}" Margin="0,0,10,0"/>
                            <StackPanel>
                              <TextBlock FontSize="11" Foreground="{DynamicResource Muted}">
                                <Run Text="{Binding PageLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Meta, Mode=OneWay}"/>
                              </TextBlock>
                              <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="NotesEmpty" Visibility="Collapsed" Style="{StaticResource Hint}" TextAlignment="Center"
                       Margin="20,30" Text="Noch keine Notizen. Werkzeug „Notiz“ wählen und auf die Seite klicken."/>
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                    DragCompleted="Splitter_DragCompleted" Cursor="SizeWE" ToolTip="Ziehen, um die Leiste breiter zu machen"/>

      <!-- Seiten -->
      <ItemsControl x:Name="PageList" Grid.Column="2" Focusable="False"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.CanContentScroll="True">
        <ItemsControl.Template>
          <ControlTemplate TargetType="ItemsControl">
            <ScrollViewer x:Name="PART_Scroll" CanContentScroll="True" Focusable="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Margin="0,8,0,24"/>
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="{Binding Width}" Height="{Binding Height}" Margin="0,8" HorizontalAlignment="Center"
                    Background="{DynamicResource PagePlaceholder}" ClipToBounds="True">
              <Grid x:Name="PageSurface" Background="Transparent" ClipToBounds="True"
                    Width="{Binding FullWidth}" Height="{Binding FullHeight}" HorizontalAlignment="Left" VerticalAlignment="Top"
                    MouseLeftButtonDown="Page_MouseDown" MouseMove="Page_MouseMove" MouseLeftButtonUp="Page_MouseUp"
                    MouseRightButtonUp="Page_RightClick">
                <Grid.RenderTransform>
                  <TranslateTransform X="{Binding CropOffsetX}" Y="{Binding CropOffsetY}"/>
                </Grid.RenderTransform>
                <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Textmarker -->
                <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ItemsControl ItemsSource="{Binding Rects}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Rectangle Width="{Binding W}" Height="{Binding H}" Fill="{Binding Fill}" RadiusX="1.5" RadiusY="1.5"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Suchtreffer -->
                <ItemsControl ItemsSource="{Binding SearchHits}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                      <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Rectangle x:Name="Hit" Width="{Binding W}" Height="{Binding H}" Fill="#55FF9F1A" RadiusX="2" RadiusY="2"/>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                          <Setter TargetName="Hit" Property="Fill" Value="#99FF7A00"/>
                          <Setter TargetName="Hit" Property="Stroke" Value="#E06000"/>
                          <Setter TargetName="Hit" Property="StrokeThickness" Value="1.5"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Textauswahl -->
                <ItemsControl ItemsSource="{Binding Selection}" IsHitTestVisible="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                      <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Rectangle Width="{Binding W}" Height="{Binding H}" Fill="{DynamicResource Selection}" RadiusX="1.5" RadiusY="1.5"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Schwärzungen -->
                <ItemsControl ItemsSource="{Binding Redactions}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                      <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Rectangle Width="{Binding W}" Height="{Binding H}" Fill="Black" Opacity="0.85"
                                 Stroke="{DynamicResource Danger}" StrokeThickness="1" Cursor="Hand"
                                 ToolTip="Klicken zum Entfernen" MouseLeftButtonDown="Redaction_MouseDown"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Notizen -->
                <ItemsControl ItemsSource="{Binding Notes}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                      <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource NoteBg}" Cursor="Hand"
                              BorderBrush="#B38A00" BorderThickness="1" ToolTip="{Binding Preview}"
                              MouseLeftButtonDown="Note_MouseDown">
                        <Border.Effect>
                          <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.25"/>
                        </Border.Effect>
                        <TextBlock Style="{StaticResource Ico}" Text="&#xE90A;" FontSize="13" Foreground="#5C4500"
                                   HorizontalAlignment="Center"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Formularfelder -->
                <ItemsControl ItemsSource="{Binding Fields}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                      <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Width="{Binding W}" Height="{Binding H}" ToolTip="{Binding Name}">
                        <TextBox x:Name="FText" Visibility="Collapsed" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Arial" FontSize="{Binding FontSize}" Padding="2,0" BorderThickness="0,0,0,1"
                                 BorderBrush="#8098C0F0" Background="#E6E8F1FF" Foreground="#111111" CaretBrush="#111111"
                                 VerticalContentAlignment="Center" TextChanged="Field_Changed"/>
                        <CheckBox x:Name="FCheck" Visibility="Collapsed" IsChecked="{Binding IsChecked}" Checked="FieldCheck_Checked"
                                  Unchecked="Field_Changed" Cursor="Hand" Margin="0" Focusable="True">
                          <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                              <Border x:Name="box" Background="#E6E8F1FF" BorderBrush="#8098C0F0" BorderThickness="1" CornerRadius="2">
                                <Viewbox Margin="2">
                                  <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="#111111" Visibility="Hidden"/>
                                </Viewbox>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </CheckBox.Template>
                        </CheckBox>
                        <ComboBox x:Name="FChoice" Visibility="Collapsed" ItemsSource="{Binding Options}" Text="{Binding Value}"
                                  IsEditable="True" FontFamily="Arial" FontSize="{Binding FontSize}" Padding="2,0"
                                  Background="#E6E8F1FF" SelectionChanged="Field_Changed" VerticalContentAlignment="Center"/>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsText}" Value="True">
                          <Setter TargetName="FText" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                          <Setter TargetName="FText" Property="AcceptsReturn" Value="True"/>
                          <Setter TargetName="FText" Property="TextWrapping" Value="Wrap"/>
                          <Setter TargetName="FText" Property="VerticalContentAlignment" Value="Top"/>
                          <Setter TargetName="FText" Property="VerticalScrollBarVisibility" Value="Auto"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCheck}" Value="True">
                          <Setter TargetName="FCheck" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChoice}" Value="True">
                          <Setter TargetName="FChoice" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Eingefügte Texte -->
                <ItemsControl ItemsSource="{Binding Texts}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                      <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid x:Name="Root">
                        <TextBox x:Name="TBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="Arial"
                                 FontSize="{Binding DisplaySize}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}"
                                 AcceptsReturn="True" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                 Padding="2,1" MinWidth="40" CaretBrush="{Binding Brush}" Cursor="IBeam"
                                 Loaded="TextItem_Loaded" LostKeyboardFocus="TextItem_LostFocus" TextChanged="TextItem_Changed">
                          <TextBox.RenderTransform>
                            <RotateTransform Angle="{Binding AngleD}"/>
                          </TextBox.RenderTransform>
                        </TextBox>
                        <Border x:Name="Bar" Visibility="Collapsed" Background="{DynamicResource Bar}" CornerRadius="9" Padding="3"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-44,0,0">
                          <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
                          </Border.Effect>
                          <StackPanel Orientation="Horizontal">
                            <Thumb Width="22" Height="26" Focusable="False" Cursor="SizeAll" DragDelta="TextItem_Move" DragCompleted="Placed_DragCompleted" ToolTip="Verschieben">
                              <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                  <Border Background="Transparent">
                                    <TextBlock Style="{StaticResource Ico}" Text="&#xE7C2;" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                  </Border>
                                </ControlTemplate>
                              </Thumb.Template>
                            </Thumb>
                            <Button Focusable="False" Padding="7,3" Click="TextSmaller_Click" ToolTip="Kleiner"><TextBlock Text="A−" FontSize="11"/></Button>
                            <Button Focusable="False" Padding="7,3" Click="TextBigger_Click" ToolTip="Größer"><TextBlock Text="A+" FontSize="13"/></Button>
                            <Button Focusable="False" Padding="7,3" Click="TextBold_Click" ToolTip="Fett"><TextBlock Text="B" FontWeight="Bold"/></Button>
                            <Button Focusable="False" Padding="5,3" Click="TextColor_Click" Tag="#111111" ToolTip="Schwarz"><Ellipse Width="14" Height="14" Fill="#111111"/></Button>
                            <Button Focusable="False" Padding="5,3" Click="TextColor_Click" Tag="#1A3FA8" ToolTip="Blau"><Ellipse Width="14" Height="14" Fill="#1A3FA8"/></Button>
                            <Button Focusable="False" Padding="5,3" Click="TextColor_Click" Tag="#C62828" ToolTip="Rot"><Ellipse Width="14" Height="14" Fill="#C62828"/></Button>
                            <Button Focusable="False" Padding="5,3" Click="TextColor_Click" Tag="#2F7D32" ToolTip="Grün"><Ellipse Width="14" Height="14" Fill="#2F7D32"/></Button>
                            <Button Focusable="False" Padding="7,3" Click="TextDelete_Click" ToolTip="Text löschen">
                              <TextBlock Style="{StaticResource Ico}" Text="&#xE74D;" FontSize="12" Foreground="{DynamicResource Danger}"/>
                            </Button>
                          </StackPanel>
                        </Border>
                      </Grid>
                      <DataTemplate.Triggers>
                        <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                          <Setter TargetName="TBox" Property="BorderBrush" Value="#55888888"/>
                        </Trigger>
                        <Trigger SourceName="Root" Property="IsKeyboardFocusWithin" Value="True">
                          <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                          <Setter TargetName="TBox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Unterschriften & Stempel -->
                <ItemsControl ItemsSource="{Binding Placed}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                      <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Width="{Binding W}" Height="{Binding H}">
                        <Grid.LayoutTransform>
                          <RotateTransform Angle="{Binding AngleD}"/>
                        </Grid.LayoutTransform>
                        <Image Source="{Binding Image}" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border x:Name="SelFrame" Margin="-4" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource Accent}"
                                Visibility="Hidden" IsHitTestVisible="False"/>
                        <Thumb Cursor="SizeAll" DragStarted="Placed_DragStarted" DragDelta="Placed_Move" DragCompleted="Placed_DragCompleted"
                               ToolTip="Ziehen zum Verschieben · Entf zum Löschen">
                          <Thumb.Template>
                            <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                          </Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="SizeGrip" Width="16" Height="16" Margin="0,0,-8,-8" Cursor="SizeNWSE"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Hidden"
                               DragStarted="Placed_DragStarted" DragDelta="Placed_Resize" DragCompleted="Placed_DragCompleted" ToolTip="Größe ändern">
                          <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                              <Ellipse Fill="{DynamicResource Accent}" Stroke="White" StrokeThickness="2"/>
                            </ControlTemplate>
                          </Thumb.Template>
                        </Thumb>
                        <Button x:Name="PlacedDel" Style="{StaticResource IconChip}" Content="&#xE74D;" Width="24" Height="24" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0" Visibility="Hidden"
                                Click="Placed_Delete" ToolTip="Entfernen"/>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="SelFrame" Property="Visibility" Value="Visible"/>
                          <Setter TargetName="SizeGrip" Property="Visibility" Value="Visible"/>
                          <Setter TargetName="PlacedDel" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Zuschneiden (Bearbeitung) -->
                <ItemsControl ItemsSource="{Binding CropEdit}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Canvas>
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="{Binding FW}" Height="{Binding Top}" Fill="#88000000" IsHitTestVisible="False"/>
                        <Rectangle Canvas.Left="0" Canvas.Top="{Binding Bottom}" Width="{Binding FW}" Height="{Binding BottomH}" Fill="#88000000" IsHitTestVisible="False"/>
                        <Rectangle Canvas.Left="0" Canvas.Top="{Binding Top}" Width="{Binding Left}" Height="{Binding H}" Fill="#88000000" IsHitTestVisible="False"/>
                        <Rectangle Canvas.Left="{Binding Right}" Canvas.Top="{Binding Top}" Width="{Binding RightW}" Height="{Binding H}" Fill="#88000000" IsHitTestVisible="False"/>
                        <Thumb Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}" Width="{Binding W}" Height="{Binding H}"
                               Cursor="SizeAll" Tag="move" DragDelta="Crop_Drag" ToolTip="Rahmen verschieben">
                          <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                              <Border Background="Transparent" BorderBrush="White" BorderThickness="2">
                                <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Margin="-1"/>
                              </Border>
                            </ControlTemplate>
                          </Thumb.Template>
                        </Thumb>
                        <Thumb Tag="tl" DragDelta="Crop_Drag" Cursor="SizeNWSE" Width="16" Height="16" Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}" Margin="-8,-8,0,0" Template="{StaticResource CropHandle}"/>
                        <Thumb Tag="tr" DragDelta="Crop_Drag" Cursor="SizeNESW" Width="16" Height="16" Canvas.Left="{Binding Right}" Canvas.Top="{Binding Top}" Margin="-8,-8,0,0" Template="{StaticResource CropHandle}"/>
                        <Thumb Tag="bl" DragDelta="Crop_Drag" Cursor="SizeNESW" Width="16" Height="16" Canvas.Left="{Binding Left}" Canvas.Top="{Binding Bottom}" Margin="-8,-8,0,0" Template="{StaticResource CropHandle}"/>
                        <Thumb Tag="br" DragDelta="Crop_Drag" Cursor="SizeNWSE" Width="16" Height="16" Canvas.Left="{Binding Right}" Canvas.Top="{Binding Bottom}" Margin="-8,-8,0,0" Template="{StaticResource CropHandle}"/>
                      </Canvas>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Suchleiste -->
      <Border x:Name="SearchBar" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,26,0"
              Background="{DynamicResource Bar}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              Padding="10,6" Visibility="Collapsed">
        <Border.Effect>
          <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Ico}" Text="&#xE721;" Foreground="{DynamicResource Muted}" Margin="2,0,8,0"/>
          <TextBox x:Name="SearchBox" Width="230" BorderThickness="0" Background="Transparent" FontSize="13.5"
                   VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
          <TextBlock x:Name="SearchInfo" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0" MinWidth="54" TextAlignment="Right"/>
          <Button Click="SearchPrev_Click" Padding="7,4" ToolTip="Vorheriger Treffer (Umschalt+F3)">
            <TextBlock Style="{StaticResource Ico}" Text="&#xE70E;" FontSize="11"/>
          </Button>
          <Button Click="SearchNext_Click" Padding="7,4" ToolTip="Nächster Treffer (Enter / F3)">
            <TextBlock Style="{StaticResource Ico}" Text="&#xE70D;" FontSize="11"/>
          </Button>
          <Button Click="SearchClose_Click" Padding="7,4" ToolTip="Schließen (Esc)">
            <TextBlock Style="{StaticResource Ico}" Text="&#xE711;" FontSize="10"/>
          </Button>
        </StackPanel>
      </Border>

      <!-- Startbildschirm -->
      <Grid x:Name="EmptyState" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource Bg}" ClipToBounds="True">
        <!-- weiche Farbflächen im Hintergrund -->
        <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-300,0,0" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#403C6E12" Offset="0"/>
              <GradientStop Color="#003C6E12" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-360" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#3300B4D8" Offset="0"/>
              <GradientStop Color="#0000B4D8" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>

        <DockPanel>
          <!-- Fußzeile mit dieapp.info -->
          <Border DockPanel.Dock="Bottom" Padding="28,14">
            <DockPanel>
              <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
              <Button Click="DieApp_Click" HorizontalAlignment="Left" Padding="8,6" ToolTip="dieapp.info öffnen">
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/dieapp.png" Height="30" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="12.5"><Run Text="Eine App von "/><Run Text="dieapp.info" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></TextBlock>
                    <TextBlock Text="Made with ♥ in Ummaschumm" Style="{StaticResource Hint}" FontSize="11"/>
                  </StackPanel>
                </StackPanel>
              </Button>
            </DockPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1180" Margin="48,40,48,10" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- links: Held + Kacheln -->
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/kanta.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0"/>
                  <TextBlock FontSize="46" VerticalAlignment="Center">
                    <Run Text="KANTA" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><Run Text="pdf" FontWeight="Light" Foreground="{DynamicResource Muted}"/>
                  </TextBlock>
                </StackPanel>
                <TextBlock Text="Lesen. Unterschreiben. Erledigt." FontSize="28" FontWeight="SemiBold" Margin="0,22,0,0"/>
                <TextBlock Text="Alles, was man mit PDFs wirklich braucht – ohne Abo, ohne Cloud, ohne Schnickschnack."
                           Foreground="{DynamicResource Muted}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,24"/>

                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource Primary}" Click="Open_Click" Padding="22,11" FontSize="14.5">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Ico}" Text="&#xE8E5;" Margin="0,0,9,0" Foreground="White"/>
                      <TextBlock Text="Datei öffnen"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Text="oder einfach Dateien ins Fenster ziehen" Style="{StaticResource Hint}" FontSize="13"
                             VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>

                <UniformGrid Columns="3" Margin="-6,30,0,0">
                  <UniformGrid.Resources>
                    <Style x:Key="TileBtn" TargetType="Button">
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="Margin" Value="6"/>
                      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="card" Background="{DynamicResource Bar}" CornerRadius="14" Padding="16,14"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                              <Border.Effect>
                                <DropShadowEffect x:Name="sh" BlurRadius="14" ShadowDepth="2" Opacity="0.06"/>
                              </Border.Effect>
                              <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="card" Property="RenderTransform">
                                  <Setter.Value><TranslateTransform Y="-2"/></Setter.Value>
                                </Setter>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </UniformGrid.Resources>
                  <Button Style="{StaticResource TileBtn}" Tag="merge" Click="Tile_Click">
                    <StackPanel>
                      <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xE8F1;" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="Zusammenfügen" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,2"/>
                      <TextBlock Text="Mehrere Dateien zu einer PDF" Style="{StaticResource Hint}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource TileBtn}" Tag="convert" Click="Tile_Click">
                    <StackPanel>
                      <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="In PDF umwandeln" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,2"/>
                      <TextBlock Text="Word, Excel, PowerPoint, Bilder" Style="{StaticResource Hint}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource TileBtn}" Tag="sign" Click="Tile_Click">
                    <StackPanel>
                      <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xEE56;" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="Unterschreiben" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,2"/>
                      <TextBlock Text="Unterschrift oder Stempel drauf" Style="{StaticResource Hint}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource TileBtn}" Tag="compress" Click="Tile_Click">
                    <StackPanel>
                      <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xE73F;" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="Verkleinern" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,2"/>
                      <TextBlock Text="Klein genug für jede E-Mail" Style="{StaticResource Hint}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource TileBtn}" Tag="ocr" Click="Tile_Click">
                    <StackPanel>
                      <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xE8FE;" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="Scan durchsuchbar" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,2"/>
                      <TextBlock Text="Texterkennung, offline" Style="{StaticResource Hint}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource TileBtn}" Tag="protect" Click="Tile_Click">
                    <StackPanel>
                      <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Ico}" Text="&#xE72E;" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="Kennwort" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,2"/>
                      <TextBlock Text="Schützen mit AES-256" Style="{StaticResource Hint}"/>
                    </StackPanel>
                  </Button>
                </UniformGrid>
              </StackPanel>

              <!-- rechts: Zuletzt geöffnet -->
              <Border Grid.Column="2" Background="{DynamicResource Bar}" CornerRadius="18" Padding="18,16"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Stretch">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.07"/>
                </Border.Effect>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Zuletzt geöffnet" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,10"/>
                  <Grid>
                    <ItemsControl x:Name="RecentList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Click="Recent_Click" HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,1"
                                  MouseRightButtonUp="Recent_RightClick" ToolTip="{Binding Path}">
                            <DockPanel>
                              <Border DockPanel.Dock="Left" Width="40" Height="54" CornerRadius="4" Background="White"
                                      BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,12,0">
                                <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                              </Border>
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Folder}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding When}" Style="{StaticResource Hint}" FontSize="11"/>
                              </StackPanel>
                            </DockPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="RecentEmpty" VerticalAlignment="Center" Margin="10,30">
                      <TextBlock Style="{StaticResource Ico}" Text="&#xE81C;" FontSize="30" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Opacity="0.6"/>
                      <TextBlock Text="Hier erscheinen deine zuletzt geöffneten Dateien." Style="{StaticResource Hint}"
                                 TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                  </Grid>
                </DockPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Grid>

    <!-- ═════════ Meldung unten ═════════ -->
    <Border x:Name="Toast" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource Bar}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ToastAction" Style="{StaticResource Primary}" Click="ToastAction_Click"/>
          <Button x:Name="ToastFolder" Content="Im Ordner zeigen" Click="ToastFolder_Click"/>
          <Button Click="ToastClose_Click" Padding="9,6">
            <TextBlock Style="{StaticResource Ico}" Text="&#xE711;" FontSize="11"/>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Ico}" Text="&#xE73E;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
          <TextBlock x:Name="ToastText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ═════════ Notiz-Editor ═════════ -->
    <Popup x:Name="NotePopup" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade"
           Placement="Right" HorizontalOffset="6" Closed="NotePopup_Closed">
      <Border Background="{DynamicResource Bar}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
              Padding="14,12" Margin="10" Width="300">
        <Border.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Click="NoteDelete_Click" Padding="7,5" ToolTip="Notiz löschen">
              <TextBlock Style="{StaticResource Ico}" Text="&#xE74D;" FontSize="13" Foreground="{DynamicResource Danger}"/>
            </Button>
            <Border Width="10" Height="10" CornerRadius="3" Background="{DynamicResource NoteBg}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="NoteMeta" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBox x:Name="NoteText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="260"
                   VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                   FontSize="13.5" Padding="0,2" PreviewKeyDown="NoteText_KeyDown"/>
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Fertig" Click="NoteDone_Click" Padding="14,5"/>
            <TextBlock Text="Strg+Enter = fertig · Esc schließt" Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
